<% layout("boilerplate.ejs") %>


<style>
  .listing-details-container {
    max-width: 750px;
    margin: 40px auto;
    padding: 25px;
  }

  .listing-card {
    background: #fff  !important;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
    border: 1px solid #f1f1f1 !important;
    transition: all 0.3s ease;
  }

  .listing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12) !important;
  }

  .listing-heading {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 25px;
    color: #222 !important;
  }

  .listing-info {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .listing-info li {
    background: #f8f9fa !important;
    padding: 15px 18px;
    margin-bottom: 12px;
    border-radius: 12px;
    font-size: 1rem;
    color: #444 !important;
    border-left: 5px solid #ff385c !important;
    word-wrap: break-word;
  }

  .action-buttons {
    display: flex;
    gap: 15px;
    margin-top: 25px;
    flex-wrap: wrap;
  }

  .edit-btn,
  .delete-btn {
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .edit-btn {
    background: linear-gradient(135deg, #ff385c, #ff6b6b) !important;
    color: white;
  }

  .edit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 56, 92, 0.3) !important;
  }

  .delete-btn {
    background: #222;
    color: white;
  }

  .delete-btn:hover {
    background: #000;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .listing-card {
      padding: 20px;
    }

    .listing-heading {
      font-size: 1.6rem;
    }

    .action-buttons {
      flex-direction: column;
    }

    .edit-btn,
    .delete-btn {
      width: 100%;
      text-align: center;
    }
  }




/* ===========================
   REVIEW SECTION
=========================== */

.review-section{
    margin: 70px auto;
}

.review-card{
    background: #ffffff;
    border-radius: 24px;
    padding: 40px;
    border: 1px solid #ececec;

    box-shadow:
        0 10px 25px rgba(0,0,0,.05),
        0 25px 60px rgba(0,0,0,.08);

    transition: .35s ease;
}

.review-card:hover{
    transform: translateY(-5px);
    box-shadow:
        0 20px 40px rgba(0,0,0,.08),
        0 35px 70px rgba(0,0,0,.12);
}

/* ===========================
   TITLE
=========================== */

.review-title{
    font-size: 2rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 35px;
}

/* ===========================
   FORM GROUP
=========================== */

.review-group{
    margin-bottom: 30px;
}

.review-group label{
    display:block;
    font-size:1rem;
    font-weight:600;
    color:#444;
    margin-bottom:10px;
}

/* ===========================
   RANGE SLIDER
=========================== */

.review-range{
    width:100%;
    cursor:pointer;
    accent-color:#ff385c;
}

/* ===========================
   TEXTAREA
=========================== */

.review-textarea{
    width:100%;
    resize:none;

    padding:18px;
    font-size:16px;

    border-radius:16px;
    border:1px solid #dcdcdc;

    outline:none;

    transition:.3s;

    background:#fafafa;
}

.review-textarea:focus{

    background:#fff;

    border-color:#ff385c;

    box-shadow:
        0 0 0 5px rgba(255,56,92,.12);

}

/* ===========================
   BUTTON
=========================== */

.review-btn{

    border:none;

    background:linear-gradient(135deg,#ff385c,#ff6b81);

    color:white;

    padding:15px 34px;

    font-size:16px;

    font-weight:600;

    border-radius:14px;

    transition:.35s;

    box-shadow:
        0 12px 25px rgba(255,56,92,.28);

}

.review-btn:hover{

    transform:translateY(-3px);

    box-shadow:
        0 18px 35px rgba(255,56,92,.38);

}

.review-btn:active{

    transform:scale(.98);

}

/* ===========================
   RESPONSIVE
=========================== */

@media(max-width:768px){

.review-card{

padding:25px;

}

.review-title{

font-size:1.6rem;

}

}


