/* Review Section Background */

.reviews-container {
    background: linear-gradient(135deg, #f8fbff, #eef4ff);
    padding: 35px;
    border-radius: 20px;
    margin-top: 25px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.08);
}

/* Heading */

.review-heading {
    font-size: 2rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 25px;
    letter-spacing: .5px;
}

/* Card */

.review-card {
    background: #ffffff;
    border: none;
    border-radius: 18px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,.08);
    transition: all .35s ease;
    position: relative;
    overflow: hidden;
}

.review-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    background: linear-gradient(180deg,#0d6efd,#6f42c1);
}

.review-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(0,0,0,.15);
}

/* Card Body */

.review-card-body {
    margin-left: 10px;
}

/* User */

.review-user {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
}

.user-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg,#0d6efd,#6610f2);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 28px;
    box-shadow: 0 5px 15px rgba(13,110,253,.35);
}

.user-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #2d3436;
}

/* Rating */

.rating {
    margin: 4px 0 0;
    color: #ff9800;
    font-weight: 600;
    font-size: 15px;
}

/* Review Text */

.review-text {
    font-size: 16px;
    color: #555;
    line-height: 1.8;
    background: #f9fbfd;
    padding: 18px;
    border-radius: 12px;
    border-left: 4px solid #0d6efd;
    margin-top: 15px;
}

/* Responsive */

@media(max-width:768px){

    .reviews-container{
        padding:20px;
    }

    .review-card{
        padding:18px;
    }

    .user-avatar{
        width:50px;
        height:50px;
        font-size:22px;
    }

    .review-heading{
        font-size:1.6rem;
    }

}


/* Image Container */
.listing-image{
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
}

/* Uniform Image Size */
.show-img{
    width: 100%;
    height: 260px;          /* Same height for all images */
    object-fit: cover;      /* Crops image while maintaining aspect ratio */
    object-position: center;
    display: block;

    transition: transform .5s ease, filter .4s ease;
}

/* Hover Effect */
.listing-image:hover .show-img{
    transform: scale(1.06);
    filter: brightness(.9);
}

/* Responsive */
@media (max-width: 992px){
    .show-img{
        height: 230px;
    }
}

@media (max-width: 768px){
    .show-img{
        height: 210px;
    }
}

@media (max-width: 576px){
    .show-img{
        height: 190px;
    }
}






  
</style>
<body>
<div class="listing-details-container">
    <div class="listing-card">

        <h3 class="listing-heading"><%= listing.title %></h3>

        <ul class="listing-info">
            <div>
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="Listing Image"
                >
            </div>
        

<p>
<i style="
display:inline-block;
padding:10px 18px;
background:#ffffff;
color:#222;
font-size:15px;
font-weight:600;
font-style:normal;
border-radius:12px;
border:1px solid #e5e7eb;
box-shadow:0 8px 24px rgba(0,0,0,.08);
">
    Owned by <span style="color:#ff385c;"><%= listing.owner.username %></span>
</i>
</p>


            <li><strong>Description:</strong> <%= listing.description %></li>
            <li><strong>Price:</strong> ₹ <%= listing.price.toLocaleString("en-IN") %></li>
            <li><strong>Location:</strong> <%= listing.location %></li>
            <li><strong>Country:</strong> <%= listing.country %></li>
        </ul>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>

        <div class="action-buttons">
            <a href="/listings/<%= listing._id %>/edit" class="edit-btn">
                Edit Listing
            </a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="delete-btn">
                    Delete Listing
                </button>
            </form>
        </div>

<%}  %>



<% if(currUser) { %>


        <hr class="review-divider">



        <h4 class="review-title">Leave a Review</h4>

        <form action="/listings/<%= listing.id  %>/reviews" method="POST" 
          novalidate
          class="needs-validation"
          >

            <div class="review-group">
    <label for="rating">
       
        <!-- <span id="ratingValue">3</span> ⭐ -->
    </label>
<fieldset class="starability-slot">
    <p>Rating:</p>

    <input
        type="radio"
        id="no-rate"
        class="input-no-rate"
        name="review[rating]"
        value="1"
        checked
        aria-label="No rating."
    />

    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
    <label for="first-rate1" title="Terrible"></label>

    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
    <label for="first-rate2" title="Not good"></label>

    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
    <label for="first-rate3" title="Average"></label>

    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
    <label for="first-rate4" title="Very good"></label>

    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
    <label for="first-rate5" title="Amazing"></label>
</fieldset>

<div class="review-form-container">
    <div class="review-group">
        <label for="comment" class="review-label">
            💬 Write Your Review
        </label>

        <textarea
            name="review[comment]"
            id="comment"
            rows="6"
            class="review-textarea form-control"
            placeholder="Share your experience with this place..."
            required
        ></textarea>

        <div class="invalid-feedback">
            Please add a comment for your review.
        </div>
    </div>
</div>

<div class="valid-feedback">
    THANK YOU FOR REVIEWING US.
</div>

<button type="submit" class="review-btn">
    Submit Review
</button>

</form>

<% } %>

       </div>
</div>



</div>


<hr>


<h3 class="review-heading">💬 All Reviews</h3>

<div class="reviews-container">

    <% for(review of listing.reviews) { %>

    <div class="review-card">
        <div class="review-card-body">

            <div class="review-user">
                <div class="user-avatar">
                    👤
                </div>

                <div>
                    <h5 class="user-name">@<%= review.author.username %></h5>
                    <p class="starability-result card-text"
                     data-rating="<%= review.rating %>">
                    </p>
                </div>
            </div>

            <p class="review-text">
                "<%= review.comment %>"
            </p>

        </div>
        <form class="mb-3" method="POST" action="/listings/<%= listing._id  %>/reviews/<%= review._id  %>?_method=Delete">
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
    </div>

    <% } %>

 
 




  <script>
    const ratingSlider = document.getElementById("rating");
    const ratingValue = document.getElementById("ratingValue");

    // Display the initial value
    ratingValue.textContent = ratingSlider.value;

    // Update the value whenever the slider moves
    ratingSlider.addEventListener("input", function () {
        ratingValue.textContent = this.value;
    });
</script>


   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>// Example starter JavaScript for disabling form submissions if there are invalid fields
(() => {
  'use strict'

  // Fetch all the forms we want to apply custom Bootstrap validation styles to
  const forms = document.querySelectorAll('.needs-validation')

  // Loop over them and prevent submission
  Array.from(forms).forEach(form => {
    form.addEventListener('submit', event => {
      if (!form.checkValidity()) {
        event.preventDefault()
        event.stopPropagation()
      }

      form.classList.add('was-validated')
    }, false)
  })
})()</script>


</body>