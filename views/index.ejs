<% layout("boilerplate.ejs") %>





<style>



/* Container & Grid spacing */
.row {
  margin-top: 2.5rem;
  row-gap: 2rem;
}

/* Card Container Styling & Smooth Lift Transition */
.listing-card {
  border: none !important;
  border-radius: 12px !important;
  overflow: hidden;
  background-color: #ffffff;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04); 
  /* Transitions both transform and box-shadow for a fluid look */
  transition: transform 0.2s ease-out, box-shadow 0.2s ease-out; 
}

/* Cursor Hover: Lift the card slightly and deepen the shadow */
.listing-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.08);
}

/* Image Styling & Smooth Opacity Transition */
.listing-card .card-img-top {
  border-radius: 12px 12px 0 0;
  transition: opacity 0.2s ease-in-out; 
}

/* Cursor Hover: Fade image opacity */
.listing-card:hover .card-img-top {
  opacity: 0.7;
}

/* Disabled Overlay (keeping layout structure intact) */
.card-img-overlay {
  display: none; 
}

/* Typography & Content Area */
.listing-card .card-body {
  padding: 1.2rem 0.5rem !important; 
  background: #ffffff;
}

/* Base Font and Color Setup */
.listing-card .card-text {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 0.95rem;
  line-height: 1.6;
}

/* Listing Title Styling */
.listing-card .card-text b {
  display: block;
  font-weight: 600;
  font-size: 1.1rem;
  letter-spacing: -0.02em; 
  color: #111111; 
  margin-bottom: 0.35rem;
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; 
}

/* Price & Nightly Rate Styling */
.listing-card .card-text {
  color: #666666; 
  font-weight: 500;
}
</style>

  <body>

<style>
/* ================= FILTER BAR ================= */

#filters{
    display:flex;
    align-items:center;
    gap:24px;
    margin:25px 0;
    padding:8px 5px;
    overflow-x:auto;
    white-space:nowrap;
    scrollbar-width:none;
}

#filters::-webkit-scrollbar{
    display:none;
}

/* ================= FILTER ITEM ================= */

.filter{
    min-width:75px;
    text-align:center;
    opacity:.75;
    cursor:pointer;
    transition:all .3s ease;
    padding:8px 6px;
    border-radius:14px;
    flex-shrink:0;
}

.filter i{
    font-size:1.35rem;
    color:#555;
    transition:.3s;
}

.filter p{
    margin-top:7px;
    margin-bottom:0;
    font-size:.82rem;
    font-weight:500;
    color:#555;
}

.filter:hover{
    opacity:1;
    transform:translateY(-3px);
}

.filter:hover i{
    color:#ff385c;
    transform:scale(1.15);
}

.filter:hover p{
    color:#222;
    font-weight:600;
}

/* Active Effect */
.filter:active{
    transform:scale(.95);
}

/* ================= TAX TOGGLE ================= */

.tax-toggle{
    margin-left:auto;
    flex-shrink:0;
    border:1px solid #ddd;
    border-radius:50px;
    padding:12px 18px;
    background:#fff;
    box-shadow:0 3px 10px rgba(0,0,0,.06);
    transition:.3s;
}

.tax-toggle:hover{
    box-shadow:0 8px 22px rgba(0,0,0,.12);
    border-color:#bbb;
}

.form-check{
    margin:0;
}

.form-check-label{
    margin-left:10px;
    font-size:.9rem;
    font-weight:500;
    color:#444;
}

.form-check-input{
    cursor:pointer;
    width:2.7rem;
    height:1.4rem;
}

.form-check-input:checked{
    background-color:#ff385c;
    border-color:#ff385c;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    #filters{
        gap:18px;
        padding-bottom:10px;
    }

    .filter{
        min-width:65px;
    }

    .filter i{
        font-size:1.2rem;
    }

    .filter p{
        font-size:.74rem;
    }

    .tax-toggle{
        margin-left:18px;
        padding:10px 14px;
    }

    .form-check-label{
        font-size:.78rem;
    }

    .tax-info{
display: none;
    }
}
</style>

<div id="filters">

    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountain</p>
    </div>

    <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-tent"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </div>

    <div class="filter">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">
                Total taxes
            </label>
        </div>
    </div>

</div>
   
<div class="row">

  <% for(let listing of allListings) { %>

    <div class="col-md-4 mb-4 mt-3">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
        <div class="card h-100 listing-card">
          <img src="<%= listing.image.url %>" 
               class="card-img-top" 
               alt="listing_image"
               style="height:20rem; object-fit:cover;">

               <div class="card-img-overlay"></div>

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              &#8377; <%= listing.price %> / night
              <i class="tax-info"> &nbsp;&nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>

  <% } %>



</div>

  


<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline"

      }else{
        info.style.display = "none"
      }
    }
  })
</script>