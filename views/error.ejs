<% layout("boilerplate.ejs")%>

<div class="row mt-5">

<div
  class="col-lg-6 col-md-8 col-11 mx-auto"
  style="
    background: linear-gradient(135deg, #ff416c, #ff4b2b, #ff7b54) !important;
    background-size: 300% 300% !important;
    animation: gradientMove 8s ease infinite, floatAlert 3s ease-in-out infinite !important;
    border-radius: 24px !important;
    padding: 1.5rem 2rem !important;
    text-align: center !important;
    box-shadow:
      0 15px 35px rgba(255, 65, 108, 0.35),
      0 0 25px rgba(255, 75, 43, 0.25) !important;
    position: relative !important;
    overflow: hidden !important;
  "
>

  <!-- Shine Effect -->
  <div style="
      position:absolute;
      top:-100%;
      left:-50%;
      width:60%;
      height:300%;
      background:rgba(255,255,255,0.18);
      transform:rotate(25deg);
      animation:shine 4s linear infinite;
  "></div>

  <h4 style="
      color:white !important;
      font-size:1.7rem !important;
      font-weight:800 !important;
      margin-bottom:0.5rem !important;
      text-shadow:0 2px 10px rgba(0,0,0,0.2) !important;
  ">
      🚨 Oops!
  </h4>

  <p style="
      color:white !important;
      font-size:1.1rem !important;
      margin:0 !important;
      font-weight:600 !important;
      letter-spacing:0.4px !important;
  ">
      ⚠️ <%= message %> ⚠️
  </p>

</div>

</div>

<style>
@keyframes gradientMove {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes floatAlert {
  0%,100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes shine {
  0% {
    left: -60%;
  }
  100% {
    left: 150%;
  }
}
</style>