<% layout("boilerplate.ejs") %>

<style>
/* =========================================
   WANDERLUST LOGIN PAGE (Airbnb-inspired)
============================================*/

body {
    background: linear-gradient(135deg, #f8fafc, #eef2ff, #f3f4f6);
    min-height: 100vh;
    overflow-x: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.login-section {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 15px;
}

.login-card {
    width: 100%;
    max-width: 500px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 40px;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.06),
        0 8px 25px rgba(0, 0, 0, 0.04);
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.logo {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    margin: 0 auto 18px auto;
    background: linear-gradient(135deg, #ff385c, #ff6b6b);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 32px;
    color: white;
    box-shadow: 0 10px 20px rgba(255, 56, 92, 0.3);
    transition: transform 0.3s ease;
}

.logo:hover {
    transform: scale(1.05) rotate(5deg);
}

.login-title {
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    color: #222222;
    margin-bottom: 8px;
}

.login-subtitle {
    text-align: center;
    color: #717171;
    margin-bottom: 32px;
    font-size: 15px;
}

.form-label {
    font-weight: 600;
    color: #222222;
    font-size: 14px;
    margin-bottom: 8px;
}

.form-control {
    height: 54px;
    border-radius: 12px;
    border: 1px solid #b0b0b0;
    transition: all 0.2s ease;
    font-size: 15px;
    padding: 0 16px;
}

.form-control:focus {
    border-color: #ff385c;
    box-shadow: 0 0 0 2px rgba(255, 56, 92, 0.15);
    color: #222222;
}

/* Password Input Group Customization */
.input-group {
    position: relative;
}

.input-group .form-control {
    border-top-right-radius: 12px !important;
    border-bottom-right-radius: 12px !important;
    padding-right: 50px;
}

.input-group-text {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10;
    font-size: 18px;
    user-select: none;
    color: #717171;
}

/* Password Strength Indicator */
.strength {
    height: 5px;
    width: 100%;
    background: #ebebeb;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
}

.strength-bar {
    height: 100%;
    width: 0%;
    transition: width 0.4s ease, background-color 0.4s ease;
}

#strengthText {
    font-size: 12px;
    margin-top: 6px;
    font-weight: 600;
    color: #717171;
    transition: color 0.3s;
}

.login-btn {
    width: 100%;
    height: 54px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #ff385c, #e61e4d);
    color: white;
    font-weight: 600;
    font-size: 16px;
    margin-top: 24px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.login-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(255, 56, 92, 0.35);
}

.login-btn:active {
    transform: translateY(1px);
}

.footer-link {
    text-align: center;
    margin-top: 24px;
    color: #222222;
    font-size: 14px;
}

.footer-link a {
    color: #ff385c;
    text-decoration: none;
    font-weight: 600;
    margin-left: 4px;
}

.footer-link a:hover {
    text-decoration: underline;
}

/* Responsive Scaling */
@media (max-width: 576px) {
    .login-card {
        padding: 30px 20px;
        border-radius: 20px;
    }

    .login-title {
        font-size: 1.6rem;
    }

    .logo {
        width: 65px;
        height: 65px;
        font-size: 26px;
    }
}
</style>

<div class="login-section">
    <div class="login-card">
        
        <div class="logo">
            <i class="fa-solid fa-earth-americas"></i>
        </div>

        <h2 class="login-title">Welcome back</h2>
        <p class="login-subtitle">Join Wanderlust and explore amazing destinations.</p>

        <form action="/login" method="POST" class="needs-validation" novalidate>
            
            <div class="mb-3">
                <label class="form-label" for="username">Username</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="username" 
                    name="username" 
                    placeholder="Enter username" 
                    required>
                <div class="invalid-feedback">
                    Please enter a username.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <div class="input-group">
                    <input 
                        type="password" 
                        class="form-control" 
                        id="password" 
                        name="password" 
                        placeholder="Enter password" 
                        required>
                    <span class="input-group-text" id="togglePassword">👁</span>
                </div>
              
            
            </div>

            <button class="login-btn" type="submit">Log in</button>

        </form>

    </div>
</div>

<script>
// Bootstrap Client-Side Validation
(() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
            }
            form.classList.add('was-validated')
        }, false)
    })
})();

// Password Visibility Toggle
const passwordInput = document.getElementById("password");
const toggleBtn = document.getElementById("togglePassword");

toggleBtn.addEventListener("click", () => {
    const isPassword = passwordInput.getAttribute("type") === "password";
    passwordInput.setAttribute("type", isPassword ? "text" : "password");
    toggleBtn.innerHTML = isPassword ? "🙈" : "👁";
});

// Real-time Password Strength Meter
const bar = document.getElementById("strengthBar");
const text = document.getElementById("strengthText");

passwordInput.addEventListener("input", () => {
    const value = passwordInput.value;
    let strength = 0;

    if (value.length > 0) {
        if (value.length >= 8) strength++;
        if (/[A-Z]/.test(value)) strength++;
        if (/[0-9]/.test(value)) strength++;
        if (/[^A-Za-z0-9]/.test(value)) strength++;
    }

    switch(strength) {
        case 0:
            bar.style.width = value.length > 0 ? "10%" : "0%";
            bar.style.backgroundColor = value.length > 0 ? "#ff4d4f" : "transparent";
            text.innerHTML = value.length > 0 ? "Very Weak" : "Password Strength";
            text.style.color = "#717171";
            break;
        case 1:
            bar.style.width = "25%";
            bar.style.backgroundColor = "#ff4d4f";
            text.innerHTML = "Weak";
            text.style.color = "#ff4d4f";
            break;
        case 2:
            bar.style.width = "50%";
            bar.style.backgroundColor = "#faad14";
            text.innerHTML = "Fair";
            text.style.color = "#faad14";
            break;
        case 3:
            bar.style.width = "75%";
            bar.style.backgroundColor = "#52c41a";
            text.innerHTML = "Good";
            text.style.color = "#52c41a";
            break;
        case 4:
            bar.style.width = "100%";
            bar.style.backgroundColor = "#16a34a";
            text.innerHTML = "Strong";
            text.style.color = "#16a34a";
            break;
    }
});
</script>