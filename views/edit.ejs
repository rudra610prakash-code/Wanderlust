<% layout("boilerplate.ejs") %>
  <body>
<style>
h3.edit-heading{
    text-align:center !important;
    font-size:2.8rem !important;
    font-weight:800 !important;
    margin:30px auto !important;
    width:fit-content !important;
    color:#ff385c !important;   /* Fallback color */
    position:relative !important;
    letter-spacing:1px !important;
    text-transform:capitalize !important;
    animation:slideDown 0.8s ease !important;
}

h3.edit-heading::after{
    content:"" !important;
    position:absolute !important;
    left:50% !important;
    bottom:-10px !important;
    transform:translateX(-50%) !important;
    width:80px !important;
    height:4px !important;
    border-radius:50px !important;
    background:#ff385c !important;
}

@keyframes slideDown{
    from{
        opacity:0 !important;
        transform:translateY(-20px) !important;
    }
    to{
        opacity:1 !important;
        transform:translateY(0) !important;
    }
}

@media(max-width:768px){
    h3.edit-heading{
        font-size:2rem !important;
    }
}
</style>

<h3 class="edit-heading">
  ✨ Edit Your Listing
</h3>
    <form
  method="POST"
  action="/listings/<%= listing._id %>?_method=PUT" novalidate
  class="needs-validation"
  enctype="multipart/form-data"
  style="
    max-width: 750px;
    margin: 30px auto;
    padding: 35px;
    background: rgba(255,255,255,0.95);
    border-radius: 24px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    animation: fadeIn 0.8s ease;
  "
>
  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(25px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modern-input,
    .modern-textarea {
      width: 100%;
      padding: 14px 18px;
      margin-top: 8px;
      border: 2px solid #dfe6e9;
      border-radius: 14px;
      font-size: 1rem;
      background: #fff;
      transition: all 0.35s ease;
      box-sizing: border-box;
      outline: none;
    }

    .modern-input:hover,
    .modern-textarea:hover {
      border-color: #ff6b6b;
      transform: translateY(-2px);
    }

    .modern-input:focus,
    .modern-textarea:focus {
      border-color: #ff385c;
      box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.15);
      transform: translateY(-2px);
    }

    .modern-label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
      color: #333;
      font-size: 15px;
    }

    .form-group {
      margin-bottom: 22px;
    }

    .modern-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #ff385c, #ff6b6b);
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(255, 56, 92, 0.25);
    }

    .modern-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 25px rgba(255, 56, 92, 0.35);
    }

    .modern-btn:active {
      transform: scale(0.98);
    }

    @media (max-width: 768px) {
      form {
        padding: 20px !important;
        margin: 15px !important;
      }

      .modern-input,
      .modern-textarea {
        padding: 12px 14px;
      }
    }



/* Image Preview Container */
.preview-image-container {
    width: 100%;
    max-width: 520px;
    margin-top: 12px;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    box-shadow:
        0 10px 30px rgba(0,0,0,.12),
        0 2px 10px rgba(0,0,0,.08);
    transition: all .35s ease;
}

.preview-image-container:hover {
    transform: translateY(-5px);
    box-shadow:
        0 20px 40px rgba(0,0,0,.18),
        0 8px 20px rgba(0,0,0,.12);
}

/* Image */
.preview-image {
    width: 100%;
    height: 320px;
    display: block;
    object-fit: cover;
    transition: transform .5s ease;
}

.preview-image-container:hover .preview-image {
    transform: scale(1.05);
}

/* Tablet */
@media (max-width: 768px) {
    .preview-image {
        height: 260px;
    }
}

/* Mobile */
@media (max-width: 576px) {
    .preview-image-container {
        max-width: 100%;
        border-radius: 14px;
    }

    .preview-image {
        height: 220px;
    }
}

form-group img {
    display: block;
    margin: 15px auto;
    max-width: 100%;
    height: auto;
    border-radius: 16px;
}

  </style>

  <div class="form-group">
    <label class="modern-label">Title</label>
    <input
      class="modern-input"
      name="listing[title]"
      value="<%= listing.title %>"
      type="text"
      required
    />
    <div class="invalid-feedback">
      Please enter TITLE
    </div>
    <div class="valid-feedback">
      TITLE  is good!
    </div>
  </div>

  <div class="form-group">
    <label class="modern-label">Description</label>
    <textarea
      class="modern-textarea"
      rows="5"
      name="listing[description]"
      required
    ><%= listing.description %></textarea>

    <div class="invalid-feedback">
      Please enter short description
    </div>
  </div>




 <div class="form-group">
    <label class="modern-label">Original Listing Image</label>

    <div class="preview-image-container">
        <img src="<%=  originalImageurl %>" alt="Listing Image" class="preview-image">
    </div>
</div>





  <div class="form-group">
    <label class="modern-label">Upload New Image</label>
    <input
      class="modern-input"
      name="listing[image]"
     
      type="file"
    
    />
    
  </div>

  <div class="form-group">
    <label class="modern-label">Price</label>
    <input
      class="modern-input"
      name="listing[price]"
      value="<%= listing.price %>"
      type="number"
      required
    />
    <div class="invalid-feedback">
      Please enter valid price
    </div>
  </div>

  <div class="form-group">
    <label class="modern-label">Country</label>
    <input
      class="modern-input"
      name="listing[country]"
      value="<%= listing.country %>"
      type="text"
      required
    />
    <div class="invalid-feedback">
      Please enter Country
    </div>
  </div>

  <div class="form-group">
    <label class="modern-label">Location</label>
    <input
      class="modern-input"
      name="listing[location]"
      value="<%= listing.location %>"
      type="text"
      required
    />
    <div class="invalid-feedback">
      Please enter location
    </div>
  </div>

  <button class="modern-btn">✨ Update Listing</button>
</form>
